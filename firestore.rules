rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isFinishedGameBetween(uid, gameId, requesterUid) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return game.status == 'finished' &&
        ((game.players.w == uid && game.players.b == requesterUid) ||
         (game.players.b == uid && game.players.w == requesterUid) ||
         (uid == requesterUid && (game.players.w == uid || game.players.b == uid)));
    }

    match /games/{gameId} {
      // Both players (and only signed-in users, incl. anonymous/guest) can read a game.
      allow read: if request.auth != null;

      // Only the host can create a game, and only in the correct "waiting for opponent" shape.
      allow create: if request.auth != null &&
        request.resource.data.players.w == request.auth.uid &&
        request.resource.data.players.b == null &&
        request.resource.data.status == 'waiting';

      allow update: if request.auth != null && (
        // Case 1: someone joining an open seat as black. They may only set players.b
        // to their own uid, and must not touch players.w.
        (resource.data.players.b == null &&
         request.resource.data.players.b == request.auth.uid &&
         request.resource.data.players.w == resource.data.players.w) ||

        // Case 2: one of the two seated players submitting a move / result update.
        // Neither seat may be reassigned once both are filled.
        ((resource.data.players.w == request.auth.uid || resource.data.players.b == request.auth.uid) &&
         request.resource.data.players.w == resource.data.players.w &&
         request.resource.data.players.b == resource.data.players.b)
      );

      allow delete: if false;
    }

    match /users/{uid} {
      // Any signed-in user (guest or real) can read a profile — needed for
      // username lookups and viewing a friend's stats.
      allow read: if request.auth != null;

      // Only the owner can create their own profile, and only in the
      // expected shape (matching lowercase username).
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.usernameLower == request.resource.data.username.lower();

      // Only the owner can update their own profile.
      allow update: if request.auth != null && request.auth.uid == uid;

      allow delete: if false;

      // Each finished game creates one immutable match-record per player here.
      // This is what wins/losses/draws and match history are both derived from —
      // deliberately no mutable "stats" counter, so there's nothing for either
      // player's client to tamper with after the fact.
      match /appliedGames/{gameId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        // Can only be created if it corresponds to a real, already-finished
        // game between exactly these two uids — and since writes here are
        // create-only (no update/delete), the same finished game can never
        // be counted twice.
        allow create: if request.auth != null && isFinishedGameBetween(uid, gameId, request.auth.uid);

        allow update, delete: if false;
      }

      // Friendship is symmetric and added in one step: adding a friend writes
      // to both your own list and theirs. A write is allowed either because
      // it's your own list (uid == you), or because you're writing yourself
      // (the requester) into someone else's list as their friend.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == friendUid) &&
          request.resource.data.username is string;
        // Removing a friendship deletes both sides in one action, so either
        // the list owner or the specific friend referenced by this entry can
        // delete it.
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
        allow update: if false;
      }

      // A friend can drop a game invite into your inbox; only you can read,
      // update (accept/decline) or clear your own inbox.
      match /invites/{inviteId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Direct messages between two friends, readable/writable by either
    // participant even while the other is offline. conversationId is the two
    // uids sorted and joined with "_", so it's derivable by both sides.
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }

  }
}
